{
  "manifest_version": 3,
  "name": "知了 · 门户通知同步",
  "version": "0.1.0",
  "description": "把校园门户的通知自动同步到本机知了（127.0.0.1:8787）",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://2kt.9xueqi.com/*",
    "https://2kt.9xueqi.com/*",
    "https://portal.chd.edu.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://portal.chd.edu.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://2kt.9xueqi.com/*",
        "http://2kt.9xueqi.com/*"
      ],
      "js": [
        "qczd.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "知了 · 门户通知同步",
    "default_popup": "popup.html"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:8787/*",
      "http://localhost:8787/*"
    ]
  }
}